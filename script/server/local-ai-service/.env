# 云犀本地 AI 服务配置
# 用途：在本机 / WSL 中模拟企业 embedding + rerank 模型网关。
# 注意：本服务仅用于开发、演示、RAG 链路验证和面试说明，不代表生产高并发推理能力。

# FastAPI 服务监听地址。WSL 中使用 0.0.0.0 方便 Windows 侧访问。
HOST=0.0.0.0

# FastAPI 服务端口。Java 本地配置可指向 http://localhost:18080。
PORT=18080

# uvicorn worker 数量。
# 建议本机使用 1；设置为 2 会加载两份 embedding/rerank 模型，占用两份内存。
WORKERS=1

# PyTorch CPU 线程数。
# 你的机器 CPU 性能较强，建议先用 4；如果本机还有其他服务，可调低。
TORCH_NUM_THREADS=4

# embedding 模型。
# bge-small-zh-v1.5 体积小，适合中文知识库向量化和本地 RAG 演示。
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# reranker 模型。
# mmarco-mMiniLMv2-L6-H384-v1 是轻量多语言 cross-encoder，适合本地模拟中文 rerank 链路。
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L6-H384-v1

# embedding 批大小。
# 本地演示建议 16~32；批量越大吞吐越好，但瞬时内存和 CPU 压力越高。
EMBEDDING_BATCH_SIZE=32

# rerank 批大小。
# reranker 比 embedding 更耗 CPU，建议先用 8；如果响应慢或 CPU 占用高，可调到 4。
RERANK_BATCH_SIZE=8

# 单次 embedding 最多文本条数。
# Java 侧批量入库时也应做对应限制，避免一次请求过大。
MAX_EMBEDDING_TEXTS=64

# 单次 rerank 最多候选文档数。
# RAG 建议向量召回 top20 以内，再 rerank 返回 top5。
MAX_RERANK_DOCUMENTS=50

# 单条文本最大字符数。
# 防止超长通话记录或文档 chunk 直接打爆本地推理服务。
MAX_TEXT_LENGTH=2000
